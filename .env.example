# Optional: a GitHub personal access token (no scopes needed) raises the API rate limit
# from 60 to 5,000 requests/hour.
GITHUB_TOKEN=
# Optional: Groq API key (free plan at console.groq.com) for /find, which turns a
# plain-language request into GitHub searches. Without it /find uses keyword search.
GROQ_API_KEY=
# Set to "false" to switch the AI part of /find off without removing the key.
FIND_AI_ENABLED=
# Shared secret for POST /api/revalidate (on-demand ISR)
REVALIDATE_SECRET=
# Public base URL for absolute links in OG tags, sitemap and robots.txt.
# Not needed on Vercel (VERCEL_PROJECT_PRODUCTION_URL is used automatically).
NEXT_PUBLIC_SITE_URL=
# Set by Vercel on deployments; only used when NEXT_PUBLIC_SITE_URL is empty.
# VERCEL_PROJECT_PRODUCTION_URL=
